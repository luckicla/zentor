<?xml version="1.0" encoding="utf-8"?>
<!-- MixUp widget, medium (4x1), like Spotify: cover, title, artist and the buttons. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:clipToOutline="true">
    <!-- solid / translucent background (tinted, with alpha) -->
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/wr_20" android:tint="#1A1530" android:importantForAccessibility="no" />
    <!-- the cover, blurred, as the background -->
    <ImageView android:id="@+id/w_bgimg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:visibility="gone" android:importantForAccessibility="no" />
    <!-- darkens / lightens the blurred cover so the text reads -->
    <ImageView android:id="@+id/w_scrim" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/wr_0" android:visibility="gone" android:importantForAccessibility="no" />
    <!-- Legacy: the hard frame -->
    <ImageView android:id="@+id/w_frame" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:visibility="gone" android:importantForAccessibility="no" />
    <!-- Legacy: the striped band (hazard tape) -->
    <ImageView android:id="@+id/w_tape" android:layout_width="match_parent" android:layout_height="5dp"
        android:layout_gravity="bottom" android:scaleType="centerCrop" android:visibility="gone" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
        <ImageView android:id="@+id/w_cover" android:layout_width="52dp" android:layout_height="52dp"
            android:scaleType="centerCrop" android:src="@drawable/wcover_ph" android:visibility="visible" android:clipToOutline="true"
            android:contentDescription="@string/widget_open" />
        <LinearLayout android:id="@+id/w_texts" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="6dp">
            <ImageView android:id="@+id/w_logo" android:layout_width="wrap_content" android:layout_height="12dp"
                android:layout_marginBottom="3dp" android:adjustViewBounds="true" android:scaleType="fitStart" android:visibility="gone"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:singleLine="true" android:ellipsize="end" android:textSize="15sp" android:textColor="#F4F0FF" android:textStyle="bold" android:text="@string/app_name"
                android:includeFontPadding="false" android:visibility="visible" />
            <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:singleLine="true" android:ellipsize="end" android:textSize="13sp" android:textColor="#B3F4F0FF" android:text="@string/widget_idle_sub"
                android:includeFontPadding="false" android:visibility="visible" />
            <TextView android:id="@+id/w_album" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:singleLine="true" android:ellipsize="end" android:textSize="12sp" android:textColor="#80F4F0FF"
                android:includeFontPadding="false" android:visibility="gone" />
        </LinearLayout>
        <ImageView android:id="@+id/w_like" android:layout_width="36dp" android:layout_height="36dp"
            android:padding="8dp" android:scaleType="fitCenter" android:src="@drawable/ic_heart_outline" android:tint="#F4F0FF"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/widget_like" />
        <ImageView android:id="@+id/w_shuffle" android:layout_width="36dp" android:layout_height="36dp"
            android:padding="8dp" android:scaleType="fitCenter" android:src="@drawable/ic_shuffle_off" android:tint="#F4F0FF"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/widget_shuffle" />
        <ImageView android:id="@+id/w_prev" android:layout_width="40dp" android:layout_height="40dp"
            android:padding="7dp" android:scaleType="fitCenter" android:src="@drawable/ic_w_prev" android:tint="#F4F0FF"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/widget_prev" />
        <FrameLayout android:id="@+id/w_play_wrap" android:layout_width="52dp" android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/widget_play">
            <ImageView android:id="@+id/w_play_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="center" android:src="@drawable/wbtn_circle" android:tint="#FF6FD8" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/w_play" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                android:src="@drawable/ic_w_play" android:tint="#1A1530" android:importantForAccessibility="no" />
        </FrameLayout>
        <ImageView android:id="@+id/w_next" android:layout_width="40dp" android:layout_height="40dp"
            android:padding="7dp" android:scaleType="fitCenter" android:src="@drawable/ic_w_next" android:tint="#F4F0FF"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/widget_next" />
        <ImageView android:id="@+id/w_repeat" android:layout_width="36dp" android:layout_height="36dp"
            android:padding="8dp" android:scaleType="fitCenter" android:src="@drawable/ic_repeat_off" android:tint="#F4F0FF"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/widget_repeat" />
        <ImageView android:id="@+id/w_cover_r" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="6dp"
            android:scaleType="centerCrop" android:src="@drawable/wcover_ph" android:visibility="gone" android:clipToOutline="true"
            android:contentDescription="@string/widget_open" />
    </LinearLayout>
</FrameLayout>
