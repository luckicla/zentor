<?xml version="1.0" encoding="utf-8"?>
<!-- MixUp widget, square «Portada» (2x2): the cover fills it, title and play over it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:clipToOutline="true">
    <!-- solid / translucent background (tinted, with alpha) -->
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/wr_20" android:tint="#1A1530" android:importantForAccessibility="no" />
    <!-- the cover, blurred, as the background -->
    <ImageView android:id="@+id/w_bgimg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:visibility="gone" android:importantForAccessibility="no" />
    <!-- darkens / lightens the blurred cover so the text reads -->
    <ImageView android:id="@+id/w_scrim" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/wr_0" android:visibility="gone" android:importantForAccessibility="no" />
    <!-- Legacy: the hard frame -->
    <ImageView android:id="@+id/w_frame" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:visibility="gone" android:importantForAccessibility="no" />
    <!-- Legacy: the striped band (hazard tape) -->
    <ImageView android:id="@+id/w_tape" android:layout_width="match_parent" android:layout_height="5dp"
        android:layout_gravity="top" android:scaleType="centerCrop" android:visibility="gone" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/w_cover" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:src="@drawable/wcover_ph" android:contentDescription="@string/widget_open" />
    <ImageView android:id="@+id/w_grad" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/wgrad_bottom" android:tint="#1A1530" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp">
        <ImageView android:id="@+id/w_logo" android:layout_width="wrap_content" android:layout_height="14dp"
                android:layout_marginBottom="3dp" android:adjustViewBounds="true" android:scaleType="fitStart" android:visibility="gone"
                android:importantForAccessibility="no" />
        <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:id="@+id/w_texts" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:singleLine="true" android:ellipsize="end" android:textSize="15sp" android:textColor="#F4F0FF" android:textStyle="bold" android:text="@string/app_name"
                android:includeFontPadding="false" android:visibility="visible" />
                <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:singleLine="true" android:ellipsize="end" android:textSize="12sp" android:textColor="#B3F4F0FF" android:text="@string/widget_idle_sub"
                android:includeFontPadding="false" android:visibility="visible" />
            </LinearLayout>
            <FrameLayout android:id="@+id/w_play_wrap" android:layout_width="48dp" android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/widget_play">
            <ImageView android:id="@+id/w_play_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="center" android:src="@drawable/wbtn_circle" android:tint="#FF6FD8" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/w_play" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
                android:src="@drawable/ic_w_play" android:tint="#1A1530" android:importantForAccessibility="no" />
        </FrameLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/w_btnrow" android:layout_width="match_parent" android:layout_height="40dp"
            android:orientation="horizontal" android:gravity="center" android:visibility="gone">
            <ImageView android:id="@+id/w_shuffle" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
            android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/ic_shuffle_off" android:tint="#F4F0FF"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/widget_shuffle" />
            <ImageView android:id="@+id/w_prev" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:padding="8dp" android:scaleType="fitCenter" android:src="@drawable/ic_w_prev" android:tint="#F4F0FF"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/widget_prev" />
            <ImageView android:id="@+id/w_like" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
            android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/ic_heart_outline" android:tint="#F4F0FF"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/widget_like" />
            <ImageView android:id="@+id/w_next" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:padding="8dp" android:scaleType="fitCenter" android:src="@drawable/ic_w_next" android:tint="#F4F0FF"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/widget_next" />
            <ImageView android:id="@+id/w_repeat" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
            android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/ic_repeat_off" android:tint="#F4F0FF"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/widget_repeat" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
